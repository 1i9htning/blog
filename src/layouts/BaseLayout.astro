---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title } = Astro.props;
const documentTitle = title ? `${title} · li9htning` : 'li9htning';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Syke-Regular-2.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/ChillRoundFRegular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/MapleMono4Li9htningNR-NFMono-CN-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <title>{documentTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到正文</a>
    <Navbar />
    <main id="main-content" class="site-main"><slot /></main>
  </body>
</html>
