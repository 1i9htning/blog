---
import BaseLayout from '../layouts/BaseLayout.astro';
import { activityLabel, formatFullDate, getContributions, type PostActivity } from '../lib/contributions';

const { years } = await getContributions();
const current = years[0];
const weekdays = ['', '周一', '', '周三', '', '周五', ''];
const levels = [0, 1, 2, 3, 4];
const activityMap: Record<string, PostActivity[]> = {};
for (const yearData of years) {
  for (const day of yearData.activityDays) activityMap[day.date] = day.activities;
}
const serializedActivities = JSON.stringify(activityMap).replace(/</g, '\\u003c');
---

<BaseLayout title="内容活动">
  <div class="page-shell contributions-page">
    <header class="page-heading">
      <h1>内容活动</h1>
      <span id="contrib-subtitle">{current.year} 年 {current.total} 次活动</span>
    </header>
    <div class="activity-panel">
      <div class="contrib-layout">
        <section class="contributions" aria-label="内容活动图">
        <div class="contrib-scroll" id="contrib-scroll">
          {years.map((yearData, index) => (
            <div
              class="contrib-year"
              data-year={yearData.year}
              data-total={yearData.total}
              hidden={index !== 0}
              style={`--contrib-weeks: ${yearData.weeks};`}
            >
              <div class="contrib-inner">
                <div class="contrib-months" aria-hidden="true">
                  {yearData.months.map((label) => <span class="contrib-month">{label}</span>)}
                </div>
                <div class="contrib-body">
                  <div class="contrib-weekdays" aria-hidden="true">
                    {weekdays.map((label) => <span>{label}</span>)}
                  </div>
                  <div class="contrib-grid">
                    {yearData.cells.map((cell) => cell.outside || cell.future ? (
                      <span class={`contrib-cell ${cell.outside ? 'outside' : 'future'}`} aria-hidden="true"></span>
                    ) : (
                      <button type="button" class="contrib-cell" data-level={cell.level} data-date={cell.date} title={cell.title} aria-label={cell.title} aria-pressed="false"></button>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
        <div class="contrib-footer" aria-hidden="true">
          <span class="contrib-legend-label">少</span>
          {levels.map((level) => <span class="contrib-cell" data-level={level}></span>)}
          <span class="contrib-legend-label">多</span>
        </div>
      </section>
      {years.length > 1 && (
        <nav class="contrib-years" aria-label="按年份查看内容活动">
          {years.map((yearData) => (
            <button
              type="button"
              class:list={['contrib-year-option', { active: yearData.year === current.year }]}
              data-year={yearData.year}
              aria-pressed={yearData.year === current.year ? 'true' : 'false'}
              aria-label={`${yearData.year} 年 ${yearData.total} 次活动`}
            >
              <span class="contrib-year-label">{yearData.year}</span>
              <span class="contrib-year-count">{yearData.total}</span>
            </button>
          ))}
        </nav>
      )}
      </div>
      <div class="contrib-details">
        <div class="contrib-details-heading">
          <div class="contrib-details-title" aria-live="polite">
            <h2 id="contrib-details-title">全部活动</h2>
            <span id="contrib-details-count">共 {current.total} 次活动</span>
          </div>
          <button type="button" id="contrib-view-all" class="clear-button" hidden>查看全部</button>
        </div>
        {years.map((yearData, index) => (
          <div class="contrib-all" data-year={yearData.year} hidden={index !== 0}>
            {yearData.activityDays.length > 0 ? (
              <ul class="contrib-details-list">
                {yearData.activityDays.map((day) => (
                  <li class="contrib-day">
                    <h3 class="contrib-day-date">{formatFullDate(day.date)}</h3>
                    <ul class="contrib-day-activities">
                      {day.activities.map((activity) => (
                        <li class="contrib-activity">
                          <a href={`/blog/${activity.id}/`}>{activity.title}</a>
                          <span class="contrib-details-kind">{activityLabel(activity.kind)}</span>
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="contrib-details-empty">暂无内容活动</p>
            )}
          </div>
        ))}
        <div id="contrib-day-list" hidden></div>
      </div>
    </div>
  </div>
  <script id="contributions-data" type="application/json" is:inline set:html={serializedActivities}></script>
  <script>
    interface ActivityJson { id: string; title: string; kind: string; }
    const labels: Record<string, string> = { created: '创建内容', updated: '更新内容', 'created-updated': '创建并更新内容' };
    const data = document.querySelector<HTMLScriptElement>('#contributions-data');
    const byDate = JSON.parse(data?.textContent ?? '{}') as Record<string, ActivityJson[]>;
    const subtitle = document.querySelector<HTMLElement>('#contrib-subtitle');
    const titleHeading = document.querySelector<HTMLElement>('#contrib-details-title');
    const countHeading = document.querySelector<HTMLElement>('#contrib-details-count');
    const allLists = [...document.querySelectorAll<HTMLElement>('.contrib-all[data-year]')];
    const dayList = document.querySelector<HTMLElement>('#contrib-day-list');
    const viewAll = document.querySelector<HTMLButtonElement>('#contrib-view-all');
    const scroll = document.querySelector<HTMLElement>('#contrib-scroll');
    const yearGrids = [...document.querySelectorAll<HTMLElement>('.contrib-year[data-year]')];
    const yearButtons = [...document.querySelectorAll<HTMLButtonElement>('.contrib-year-option[data-year]')];
    let activeYear = yearGrids.find((grid) => !grid.hidden)?.dataset.year ?? `${new Date().getFullYear()}`;

    function activeTotal(): number {
      const grid = yearGrids.find((item) => item.dataset.year === activeYear);
      return grid ? Number(grid.dataset.total ?? 0) : 0;
    }

    function formatDate(date: string): string {
      const [year, month, day] = date.split('-').map(Number);
      return `${year} 年 ${month} 月 ${day} 日`;
    }

    function createRow(activity: ActivityJson): HTMLLIElement {
      const row = document.createElement('li');
      row.className = 'contrib-activity';
      const link = document.createElement('a');
      link.href = `/blog/${activity.id}/`;
      link.textContent = activity.title;
      const kind = document.createElement('span');
      kind.className = 'contrib-details-kind';
      kind.textContent = labels[activity.kind] ?? '内容活动';
      row.append(link, kind);
      return row;
    }

    function clearSelection(): void {
      for (const cell of document.querySelectorAll('.contrib-cell.selected')) {
        cell.classList.remove('selected');
        cell.setAttribute('aria-pressed', 'false');
      }
    }

    function renderAll(): void {
      if (titleHeading) titleHeading.textContent = '全部活动';
      if (countHeading) countHeading.textContent = `共 ${activeTotal()} 次活动`;
      for (const list of allLists) list.hidden = list.dataset.year !== activeYear;
      if (dayList) dayList.hidden = true;
      if (viewAll) viewAll.hidden = true;
      clearSelection();
    }

    function renderDay(date: string): void {
      const activities = byDate[date] ?? [];
      if (titleHeading) titleHeading.textContent = formatDate(date);
      if (countHeading) countHeading.textContent = activities.length > 0 ? `${activities.length} 次活动` : '无活动';
      if (dayList) {
        dayList.replaceChildren();
        if (activities.length === 0) {
          const empty = document.createElement('p');
          empty.className = 'contrib-details-empty';
          empty.textContent = '这一天没有内容活动';
          dayList.append(empty);
        } else {
          const list = document.createElement('ul');
          list.className = 'contrib-details-list';
          for (const activity of activities) list.append(createRow(activity));
          dayList.append(list);
        }
        dayList.hidden = false;
      }
      for (const list of allLists) list.hidden = true;
      if (viewAll) viewAll.hidden = false;
    }

    function selectCell(cell: HTMLButtonElement): void {
      clearSelection();
      cell.classList.add('selected');
      cell.setAttribute('aria-pressed', 'true');
      renderDay(cell.dataset.date ?? '');
    }

    function selectYear(year: string): void {
      if (year === activeYear) return;
      activeYear = year;
      for (const grid of yearGrids) grid.hidden = grid.dataset.year !== year;
      for (const button of yearButtons) {
        const active = button.dataset.year === year;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      }
      if (subtitle) subtitle.textContent = `${year} 年 ${activeTotal()} 次活动`;
      if (scroll) scroll.scrollLeft = 0;
      renderAll();
    }

    scroll?.addEventListener('click', (event) => {
      const cell = (event.target as Element | null)?.closest?.('.contrib-cell[data-date]');
      if (cell instanceof HTMLButtonElement) selectCell(cell);
    });

    for (const button of yearButtons) {
      button.addEventListener('click', () => selectYear(button.dataset.year ?? ''));
    }
    viewAll?.addEventListener('click', renderAll);
  </script>
</BaseLayout>
