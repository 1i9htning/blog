---
import { getAvatarSrc } from '../lib/avatar';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
  { href: '/', label: '首页', active: path === '/' },
  { href: '/content/', label: '内容', active: path === '/content' || path.startsWith('/blog/') },
  { href: '/tags/', label: '标签', active: path === '/tags' },
];
const meActive = path === '/me';
const avatarSrc = await getAvatarSrc();
---

<header class="site-header">
  <div class="navbar-inner">
    <div class="brand-area">
      <a class:list={['brand-link', { active: meActive }]} href="/me/" title="关于我" aria-current={meActive ? 'page' : undefined}>
        <img class="brand-avatar" src={avatarSrc} alt="" width="28" height="28" />
        <span class="brand-text">Li9htning's blog</span>
      </a>
    </div>
    <nav class="main-nav" aria-label="主导航">
      {links.map((link) => (
        <a class:list={['nav-link', { active: link.active }]} href={link.href} aria-current={link.active ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
    <button id="theme-toggle" class="icon-button" type="button" aria-label="切换主题" title="切换主题">
      <svg class="theme-icon moon-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.2 15.4A8.8 8.8 0 0 1 8.6 3.8 9 9 0 1 0 20.2 15.4Z" /></svg>
      <svg class="theme-icon sun-icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </button>
    <form id="nav-search-form" class="nav-search" action="/content/" method="get" role="search">
      <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
      <input id="nav-search-input" type="search" name="search" placeholder="搜索标题" aria-label="搜索标题" autocomplete="off" spellcheck="false" />
    </form>
  </div>
</header>
